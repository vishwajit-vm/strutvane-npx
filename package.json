{
  "name": "strutvane",
  "version": "0.2.0-next.0",
  "description": "npx strutvane: inside a Strutvane project it runs exactly what `node strut` runs, with the project's own @strutvane/framework; outside one it points you to `npm create strutvane`. A guard: never installs or downloads anything, zero dependencies.",
  "keywords": [
    "strutvane",
    "cli",
    "npx",
    "framework",
    "typescript"
  ],
  "homepage": "https://github.com/vishwajit-vm/strutvane-npx#readme",
  "bugs": {
    "url": "https://github.com/vishwajit-vm/strutvane-npx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishwajit-vm/strutvane-npx.git"
  },
  "license": "MIT",
  "author": "The Strutvane Authors",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "strutvane": "dist/bin.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown",
    "ci": "biome check . && tsc --noEmit && vitest run --coverage && tsdown",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "strutvane": {
    "allowConsole": [
      "src/bin.ts"
    ]
  },
  "allowScripts": {
    "fsevents@2.3.3": false
  }
}
